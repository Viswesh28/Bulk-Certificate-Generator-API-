# Copy to .env and adjust as needed. All settings have sensible defaults.

# Relational database. SQLite by default (zero setup); switch to Postgres in production:
DATABASE_URL=sqlite:///./certificates.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/certificates

# Where generated PDF files are stored (local-disk backend).
STORAGE_DIR=storage/certificates

# Number of concurrent background jobs rendered at once.
WORKER_CONCURRENCY=2

# Maximum recipients accepted in a single job (larger lists must be split).
MAX_RECIPIENTS_PER_JOB=1000
